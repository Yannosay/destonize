<Window x:Class="Destonize.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="650" Width="850"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="10" Background="{StaticResource WindowBackgroundBrush}">
            <TabItem Header="General">
                <StackPanel Margin="15" Background="{StaticResource WindowBackgroundBrush}">
                    <CheckBox Name="AutoUpdateCheckBox" Content="Enable automatic updates" Margin="0,8"/>
                    <TextBlock Text="Update source URL:" Margin="0,8,0,0"/>
                    <TextBox Name="UpdateSourceBox" Margin="0,0,0,10"/>
                    <CheckBox Name="MinimizeToTrayCheckBox" Content="Minimize to system tray" Margin="0,8"/>
                    <CheckBox Name="StartWithWindowsCheckBox" Content="Start with Windows" Margin="0,8"/>
                    <CheckBox Name="ConfirmBeforeOrganizeCheckBox" Content="Ask for confirmation before organizing" Margin="0,8"/>
                    <CheckBox Name="ShowSplashCheckBox" Content="Show splash screen at startup" Margin="0,8"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Sorting">
                <StackPanel Margin="15" Background="{StaticResource WindowBackgroundBrush}">
                    <CheckBox Name="SkipHiddenFilesCheckBox" Content="Skip hidden files" Margin="0,8"/>
                    <CheckBox Name="SkipSystemFilesCheckBox" Content="Skip system files" Margin="0,8"/>
                    <CheckBox Name="CreateUndoLogCheckBox" Content="Create undo log" Margin="0,8"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Categories">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Categories" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox Name="CategoriesListBox" SelectionChanged="CategoriesListBox_SelectionChanged" Background="{StaticResource ListBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" Height="300"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="New" Width="60" Click="NewCategory_Click" Margin="0,0,5,0"/>
                            <Button Content="Delete" Width="60" Click="DeleteCategory_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Extensions" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox Name="ExtensionsListBox" Background="{StaticResource ListBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" Height="250"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBox Name="NewExtensionBox" Width="120" Margin="0,0,5,0"/>
                            <Button Content="Add" Width="60" Click="AddExtension_Click" Margin="0,0,5,0"/>
                            <Button Content="Remove" Width="60" Click="RemoveExtension_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="System Information">
                <Grid Margin="15" Background="{StaticResource WindowBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer Name:" Margin="0,5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="ComputerNameText" Margin="5,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OS:" Margin="0,5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="OSText" Margin="5,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU:" Margin="0,5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Name="CPUText" Margin="5,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory:" Margin="0,5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Name="MemoryText" Margin="5,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="PowerShell:" Margin="0,5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Name="PowerShellText" Margin="5,5"/>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Name="SaveButton" Content="Save" Width="90" Height="30" Click="Save_Click"/>
            <Button Name="CancelButton" Content="Cancel" Width="90" Height="30" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>