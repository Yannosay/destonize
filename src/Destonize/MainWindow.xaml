<Window x:Class="Destonize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destonize" Height="720" Width="1100"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{StaticResource MenuBackgroundBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Organize..." Click="Organize_Click"/>
                <Separator/>
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Click="Refresh_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="Organize..." Width="100" Height="28" Click="Organize_Click" Margin="0,0,10,0"/>
                <Button Content="Refresh" Width="90" Height="28" Click="Refresh_Click" Margin="0,0,10,0"/>
                <Button Content="Undo Last" Width="90" Height="28" Click="Undo_Click" Margin="0,0,10,0"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="SearchBox" Height="28" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" Margin="10,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Organize Desktop..." Margin="0,0,0,5" Click="Organize_Click"/>
                    <Button Content="Settings" Margin="0,0,0,5" Click="Settings_Click"/>
                    <Button Content="Refresh List" Margin="0,0,0,5" Click="Refresh_Click"/>
                    <Button Content="Undo Last Move" Margin="0,0,0,5" Click="Undo_Click"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Desktop Files" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListView Grid.Row="1" Name="FilesListView" ItemsSource="{Binding FilteredFiles}"
                          >
                    <ListView.View>
                        <GridView >
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeFormatted}"/>
                            <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding LastModified}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Background="{StaticResource MenuBackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding Files.Count, StringFormat='Files: {0}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Text="Destonize v0.0.1"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>