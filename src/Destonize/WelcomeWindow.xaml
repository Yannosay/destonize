<Window x:Class="Destonize.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Destonize" Height="420" Width="600"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Welcome to Destonize!" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14"
                   Text="Destonize helps you organize your desktop automatically by moving files to specific folders based on rules you define.&#10;&#10;By using this application, you grant it permission to access and modify files on your desktop. Please review the terms and accept to continue."/>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="14" FontStyle="Italic"
                   Text="Note: Please consider version 0.0.1 to be an 'alpha' release. You may encounter numerous bugs. Bug reports: @yannosay on Discord or GitHub."/>
        <CheckBox Grid.Row="3" Name="AcceptCheckBox" Content="I understand and accept access to my desktop" Margin="0,20,0,10"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CancelButton" Content="Cancel" Width="100" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Name="ContinueButton" Content="Continue" Width="100" Height="30" IsEnabled="False" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>