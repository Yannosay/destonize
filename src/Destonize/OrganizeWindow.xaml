<Window x:Class="Destonize.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organize Desktop" Height="820" Width="1200"
        MinHeight="700" MinWidth="1000"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Organize Your Desktop" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Create rules to automatically move files into folders." FontSize="16" Foreground="{StaticResource ForegroundBrush}" Opacity="0.8"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Load Schema..." Width="140" Height="36" FontSize="14" Click="LoadSchema_Click" Margin="0,0,10,0"/>
                <Button Content="Save Schema..." Width="140" Height="36" FontSize="14" Click="SaveSchema_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Rules" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Order matters – first matching rule wins" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView Grid.Row="1" Name="RulesListView" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          FontSize="14" HorizontalContentAlignment="Stretch"
                          ItemContainerStyle="{StaticResource RuleListViewItemStyle}"
                          KeyDown="RulesListView_KeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Content.Index}" FontWeight="Bold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Enabled" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Rule" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding ConditionSummary}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Destination}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Move Up" Width="80" Height="32" Click="MoveUp_Click" Margin="0,0,5,0"/>
                    <Button Content="Move Down" Width="80" Height="32" Click="MoveDown_Click" Margin="0,0,5,0"/>
                    <Button Content="Duplicate" Width="90" Height="32" Click="DuplicateRule_Click" Margin="0,0,5,0"/>
                    <Button Content="Delete Rule" Width="100" Height="32" Click="RemoveRule_Click" Margin="0,0,5,0" Background="#FF5A1E1E"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Rule Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <GroupBox Header="Basic Information" FontSize="16" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Name" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="RuleNameBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Destination folder" FontWeight="Bold" Margin="0,5,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="RuleDestinationBox" Grid.Column="0" FontSize="14" Padding="6" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="..." Width="40" Height="32" FontSize="14" Click="BrowseDestination_Click"/>
                            </Grid>
                            <TextBlock Text="Category (optional – move all files of this type)" FontWeight="Bold" Margin="0,10,0,5"/>
                            <ComboBox Name="RuleCategoryBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Pattern (optional, e.g. *.png, or text)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="RulePatternBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Tip: You can use either Category or Pattern alone – no need to specify both." FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="AdvancedOptionsCheckBox" Content="Show advanced options (filters, size, age, exclusions)" FontSize="14" Margin="0,0,0,10"
                              Checked="AdvancedOptionsCheckBox_Changed" Unchecked="AdvancedOptionsCheckBox_Changed"/>

                    <GroupBox x:Name="ConditionsGroupBox" Header="Advanced Matching Conditions" FontSize="16" Padding="10" Margin="0,0,0,15"
                              Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Name filter (optional)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="RuleNameFilterBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Size Range (MB)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="MinSizeBox" Grid.Column="0" FontSize="14" Padding="6" Margin="0,0,5,0"/>
                                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="MaxSizeBox" Grid.Column="2" FontSize="14" Padding="6"/>
                            </Grid>
                            <TextBlock Text="Age Range (Days)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="MinAgeBox" Grid.Column="0" FontSize="14" Padding="6" Margin="0,0,5,0"/>
                                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Name="MaxAgeBox" Grid.Column="2" FontSize="14" Padding="6"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="ExclusionsGroupBox" Header="Exclusions and Inclusions" FontSize="16" Padding="10" Margin="0,0,0,15"
                              Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Name Exclusions (comma separated)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="NameExclusionsBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Extension Exclusions (comma separated, no dots)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="ExtExclusionsBox" FontSize="14" Padding="6" Margin="0,0,0,10"/>
                            <TextBlock Text="Extension Inclusions (comma separated, no dots)" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox Name="ExtInclusionsBox" FontSize="14" Padding="6"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Add Rule" Width="120" Height="40" FontSize="14" Click="AddRule_Click" Margin="0,0,10,0"/>
                        <Button Content="Update Selected" Width="140" Height="40" FontSize="14" Click="UpdateRule_Click" Margin="0,0,10,0"/>
                        <Button Content="Clear Form" Width="120" Height="40" FontSize="14" Click="ClearForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Preview: Desktop files will be moved to folders according to rules." FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Width="120" Height="40" FontSize="14" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Organize Now" Width="160" Height="40" FontSize="14" Background="{StaticResource AccentBrush}" Click="OrganizeNow_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
