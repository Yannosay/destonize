<Window x:Class="Destonize.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Height="220" Width="450"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Update Available" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Name="UpdateInfoText" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="UpdateNowButton" Content="Update now" Width="100" Height="30" Margin="0,0,10,0" Click="UpdateNow_Click"/>
            <Button Name="RemindButton" Content="Remind tomorrow" Width="120" Height="30" Margin="0,0,10,0" Click="Remind_Click"/>
            <Button Name="SkipButton" Content="Skip version" Width="100" Height="30" Click="Skip_Click"/>
        </StackPanel>
    </Grid>
</Window>