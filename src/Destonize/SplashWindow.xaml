<Window x:Class="Destonize.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destonize" Height="400" Width="600"
        Background="Transparent"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Image x:Name="SplashImage" Stretch="Fill" />
        <TextBlock x:Name="VersionText" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.8" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>